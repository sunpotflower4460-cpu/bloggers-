# Dashboard authentication. Required in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 64 hex characters. Example generator: openssl rand -hex 32
# Keep this key in a separate secret store too: DB backups cannot decrypt saved blog credentials without it.
APP_ENCRYPTION_KEY=

AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

DATABASE_PATH=./data/blog-garden.sqlite

# Docker backup policy. BLOG_GARDEN_BACKUP_DIR is a host path outside the primary Docker volume.
BLOG_GARDEN_BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Optional: one-line JSON for a Google service account.
# GA4: add the service-account email as a Viewer on the target property.
# Search Console: add the same email as a user on each configured property.
# Blog Garden requests only analytics.readonly / webmasters.readonly scopes.
GOOGLE_SERVICE_ACCOUNT_JSON=
