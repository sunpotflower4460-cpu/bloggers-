PORT=3000
BLOGGERS_DATA_FILE=./data/state.json

# Authentication / RBAC.
# Legacy compatibility: this token is always treated as admin.
BLOGGERS_ADMIN_TOKEN=

# Optional additional principals. BLOGGERS_RBAC_JSON stores only token environment-variable NAMES,
# never the token values themselves. Roles: viewer < editor < admin.
BLOGGERS_VIEWER_TOKEN=
BLOGGERS_EDITOR_TOKEN=
BLOGGERS_SECOND_ADMIN_TOKEN=
BLOGGERS_RBAC_JSON=[{"id":"viewer","name":"Read only","role":"viewer","tokenEnv":"BLOGGERS_VIEWER_TOKEN"},{"id":"editor","name":"Editorial operator","role":"editor","tokenEnv":"BLOGGERS_EDITOR_TOKEN"},{"id":"admin-2","name":"Second admin","role":"admin","tokenEnv":"BLOGGERS_SECOND_ADMIN_TOKEN"}]

# Optional outbound request timeouts in milliseconds.
BLOGGERS_CMS_TIMEOUT_MS=15000
BLOGGERS_ANALYTICS_TIMEOUT_MS=12000
BLOGGERS_AI_TIMEOUT_MS=120000

# Optional AI provider (OpenAI-compatible chat-completions endpoint).
BLOGGERS_AI_BASE_URL=
BLOGGERS_AI_API_KEY=

# Fallback model for every role.
BLOGGERS_AI_MODEL=

# Optional role-specific model routing. These override BLOGGERS_AI_MODEL.
BLOGGERS_AI_DECIDE_MODEL=
BLOGGERS_AI_WRITE_MODEL=
BLOGGERS_AI_REVISE_MODEL=

# Optional cost estimation. USD per 1M tokens.
BLOGGERS_AI_INPUT_USD_PER_1M=0
BLOGGERS_AI_OUTPUT_USD_PER_1M=0

# Optional per-model pricing override, for example:
# {"model-a":{"input":1.25,"output":10},"model-b":{"input":0.2,"output":0.8}}
BLOGGERS_AI_PRICING_JSON={}

# Example WordPress credentials. Store Application Passwords here, never in app data.
# Blog configuration contains only WP_MUSIC_USER / WP_MUSIC_PASSWORD references.
WP_MUSIC_USER=
WP_MUSIC_PASSWORD=

# Example Ghost Custom Integration Admin API key.
# Format is id:hex_secret. Blog configuration stores only GHOST_MUSIC_ADMIN_KEY.
GHOST_MUSIC_ADMIN_KEY=

# Google OAuth refresh credentials shared by Search Console / GA4.
# Refreshed access tokens are cached in memory only and are never written to the JSON store.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional compatibility fallback: already-issued access tokens.
# If refresh credentials above are unavailable, each source can use its own access-token env.
GSC_ACCESS_TOKEN=
GA4_ACCESS_TOKEN=

# Optional custom metrics endpoint bearer token.
BLOG_METRICS_TOKEN=
