# Dashboard authentication. Required in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 64 hex characters. Example generator: openssl rand -hex 32
# Keep this key in a separate secret store too: DB backups cannot decrypt saved blog credentials without it.
APP_ENCRYPTION_KEY=

# Primary Responses-compatible AI route.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_PRIMARY_PROVIDER_LABEL=primary

# Optional one-step bounded fallback. A request retries at most once, and only for timeout/network,
# HTTP 408/425/429, or 5xx provider availability failures.
# For another model on the same API host, only AI_FALLBACK_MODEL is required; the primary key may be reused.
# If AI_FALLBACK_BASE_URL points to a different host, AI_FALLBACK_API_KEY is REQUIRED and must differ
# from AI_API_KEY so the primary credential can never be forwarded to another provider accidentally.
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_PROVIDER_LABEL=fallback
# After 3 consecutive retryable primary failures, bypass primary for this many minutes, then probe again.
AI_PRIMARY_CIRCUIT_MINUTES=30
# Safety default: if fallback generated the final reader-facing article, force it to review/draft and
# skip fallback-generated mutations of already-published content. Set allow-auto only after validating fallback quality.
AI_FALLBACK_CONTENT_POLICY=review

# Autonomous cost guard. Every actual outbound primary or fallback request consumes the shared call budget.
AI_DAILY_CALL_LIMIT=100
# Applied when the provider returns Responses-style usage.total_tokens. Calls are still capped if usage is unavailable.
AI_DAILY_TOKEN_LIMIT=2000000
AI_BUDGET_TIMEZONE=Asia/Tokyo
# Optional provider-compatible per-response cap. Leave empty if a Responses-compatible provider does not support it.
AI_MAX_OUTPUT_TOKENS=

DATABASE_PATH=./data/blog-garden.sqlite

# Direct app port binds to localhost by default. The production Caddy preset proxies to it internally.
BLOG_GARDEN_BIND_ADDRESS=127.0.0.1
# Required when using docker-compose.prod.yml. Point this DNS name to the server first.
BLOG_GARDEN_DOMAIN=blog.example.com

# Docker backup policy. BLOG_GARDEN_BACKUP_DIR is a host path outside the primary Docker volume.
BLOG_GARDEN_BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Optional independent dead-man monitoring. Point these secret URLs at a managed heartbeat/dead-man service.
# Worker pings only after a completed garden cycle; backup pings only after integrity_check=ok.
# Production requires HTTPS. URLs are never printed and redirects are refused to avoid leaking secret tokens.
EXTERNAL_WORKER_HEARTBEAT_URL=
EXTERNAL_BACKUP_HEARTBEAT_URL=

# Independent operations monitor. Checks hourly by default.
MONITOR_INTERVAL_SECONDS=3600
# Optional HTTPS webhook. If unset, incidents are still retained in SQLite but no outbound notification is sent.
ALERT_WEBHOOK_URL=
# auto detects Slack/Discord URLs; use generic for a custom endpoint receiving flat JSON.
ALERT_WEBHOOK_KIND=auto

# Optional encrypted off-host copy via docker-compose.offsite.yml / restic 0.19.1.
# Examples: s3:s3.amazonaws.com/my-bucket/blog-garden or sftp:user@backup-host:/srv/blog-garden
RESTIC_REPOSITORY=
# Use a strong password different from APP_ENCRYPTION_KEY and preserve it outside this VPS.
RESTIC_PASSWORD=
OFFSITE_BACKUP_INTERVAL_SECONDS=86400
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
# Backend-specific restic variables (AWS_*, B2_*, etc.) can be added to .env when needed.

# Optional: one-line JSON for a Google service account.
# GA4: add the service-account email as a Viewer on the target property.
# Search Console: add the same email as a user on each configured property.
# Blog Garden requests only analytics.readonly / webmasters.readonly scopes.
GOOGLE_SERVICE_ACCOUNT_JSON=
