PORT=3000
BLOGGERS_DATA_FILE=./data/state.json

# Required before exposing Bloggers HQ beyond localhost.
# Use a long random value. The browser keeps it only in sessionStorage.
BLOGGERS_ADMIN_TOKEN=

# Optional AI provider (OpenAI-compatible chat-completions endpoint)
BLOGGERS_AI_BASE_URL=
BLOGGERS_AI_API_KEY=
BLOGGERS_AI_MODEL=

# Example WordPress credentials. Store Application Passwords here, never in app data.
WP_MUSIC_USER=
WP_MUSIC_PASSWORD=

# Optional Analytics access tokens.
# The Blog settings store only these environment-variable NAMES, never token values.
# Current Foundation uses already-issued OAuth access tokens; automatic refresh is a later production-hardening step.
GSC_ACCESS_TOKEN=
GA4_ACCESS_TOKEN=

# Optional custom metrics endpoint bearer token.
BLOG_METRICS_TOKEN=
