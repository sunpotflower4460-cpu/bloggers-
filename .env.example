PORT=3000

# Storage. JSON remains the dependency-free default.
BLOGGERS_STORAGE_DRIVER=json
BLOGGERS_DATA_FILE=./data/state.json
# Cross-process JSON transaction lock safeguards for web + standalone worker on one shared filesystem.
BLOGGERS_JSON_LOCK_TIMEOUT_MS=10000
BLOGGERS_JSON_STALE_LOCK_MS=300000

# PostgreSQL is optional and no DB driver is bundled in this repository.
# When BLOGGERS_STORAGE_DRIVER=postgres, point this at a deployment-provided ESM module
# exporting either `pool`, a default pool, or async `createPool({ env })`.
# The returned pool must implement connect() and query().
BLOGGERS_POSTGRES_POOL_MODULE=
DATABASE_URL=
# Source JSON used by `npm run migrate:postgres`. Defaults to BLOGGERS_DATA_FILE.
BLOGGERS_MIGRATION_JSON_FILE=

# Scheduler runtime.
# embedded: npm start runs the scheduler inside the web process.
# external: npm start serves only HTTP/UI; run `npm run worker` separately with the same storage.
BLOGGERS_SCHEDULER_MODE=embedded
# A worker leases at most this many jobs at once and processes them concurrently. Range: 1..20.
BLOGGERS_WORKER_CONCURRENCY=4
# Lease heartbeat keeps long jobs owned by their worker. Minimum runtime handling is enforced by the scheduler.
BLOGGERS_JOB_LEASE_MS=300000

# Secret resolver.
# Empty = env-only. Otherwise point to a deployment-provided ESM module exporting
# createSecretResolver({ env }), resolver, or a default resolver.
# The module may preload asynchronously at startup, but resolve(key) must be synchronous afterward.
BLOGGERS_SECRET_PROVIDER_MODULE=
# Secret fields may use either ENV_NAME / env:ENV_NAME or managed:logical/key references.

# Authentication / token RBAC.
# Legacy compatibility: this token is always treated as admin.
BLOGGERS_ADMIN_TOKEN=
# Optional reference override, e.g. managed:bloggers/admin-token.
BLOGGERS_ADMIN_TOKEN_REF=

# Optional additional principals. tokenEnv is a legacy field name but accepts any secret reference,
# including managed:logical/key. Roles: viewer < editor < admin.
BLOGGERS_VIEWER_TOKEN=
BLOGGERS_EDITOR_TOKEN=
BLOGGERS_SECOND_ADMIN_TOKEN=
BLOGGERS_RBAC_JSON=[{"id":"viewer","name":"Read only","role":"viewer","tokenEnv":"BLOGGERS_VIEWER_TOKEN"},{"id":"editor","name":"Editorial operator","role":"editor","tokenEnv":"BLOGGERS_EDITOR_TOKEN"},{"id":"admin-2","name":"Second admin","role":"admin","tokenEnv":"BLOGGERS_SECOND_ADMIN_TOKEN"}]

# Optional OIDC browser login. Leave all values empty to keep OIDC disabled.
# Production should use HTTPS. HTTP may be enabled only for localhost development with the explicit flag below.
BLOGGERS_OIDC_ISSUER=
BLOGGERS_OIDC_CLIENT_ID=
BLOGGERS_OIDC_CLIENT_SECRET_REF=
# Example backing environment variable for the client-secret reference above.
BLOGGERS_OIDC_CLIENT_SECRET=
BLOGGERS_PUBLIC_BASE_URL=
# Current HMAC signing secret for HttpOnly browser sessions. Must resolve to at least 32 bytes.
# New flow/session cookies are always signed only by this current key.
BLOGGERS_SESSION_SECRET_REF=
BLOGGERS_SESSION_SECRET=
# Optional comma-separated previous signing-secret references for rotation grace. Maximum 2.
# Previous keys are verification-only and may be removed after the desired grace window / max session TTL.
# Example: BLOGGERS_SESSION_PREVIOUS_SECRET_REFS=OLD_BLOGGERS_SESSION_SECRET
BLOGGERS_SESSION_PREVIOUS_SECRET_REFS=
OLD_BLOGGERS_SESSION_SECRET=
# Example: [{"claim":"groups","value":"bloggers-admins","role":"admin"},{"claim":"groups","value":"bloggers-editors","role":"editor"}]
# If no rule matches, login is denied unless BLOGGERS_OIDC_DEFAULT_ROLE is explicitly set.
BLOGGERS_OIDC_ROLE_RULES_JSON=[]
BLOGGERS_OIDC_DEFAULT_ROLE=
BLOGGERS_OIDC_SCOPES="openid profile email"
BLOGGERS_SESSION_TTL_SECONDS=28800
BLOGGERS_OIDC_CLOCK_SKEW_SECONDS=60
BLOGGERS_OIDC_TIMEOUT_MS=12000
BLOGGERS_OIDC_ALLOW_INSECURE_LOCALHOST=false

# Optional outbound request timeouts in milliseconds.
BLOGGERS_CMS_TIMEOUT_MS=15000
BLOGGERS_ANALYTICS_TIMEOUT_MS=12000
BLOGGERS_AI_TIMEOUT_MS=120000

# Optional AI provider (OpenAI-compatible chat-completions endpoint).
BLOGGERS_AI_BASE_URL=
BLOGGERS_AI_API_KEY=
# Optional managed/env reference override, e.g. managed:bloggers/ai/api-key.
BLOGGERS_AI_API_KEY_REF=

# Fallback model for every role.
BLOGGERS_AI_MODEL=

# Optional role-specific model routing. These override BLOGGERS_AI_MODEL.
BLOGGERS_AI_DECIDE_MODEL=
BLOGGERS_AI_WRITE_MODEL=
BLOGGERS_AI_REVISE_MODEL=

# Optional cost estimation. USD per 1M tokens.
BLOGGERS_AI_INPUT_USD_PER_1M=0
BLOGGERS_AI_OUTPUT_USD_PER_1M=0

# Optional per-model pricing override, for example:
# {"model-a":{"input":1.25,"output":10},"model-b":{"input":0.2,"output":0.8}}
BLOGGERS_AI_PRICING_JSON={}

# Example WordPress credentials. Store Application Passwords here, never in app data.
# Blog configuration can contain WP_MUSIC_USER / WP_MUSIC_PASSWORD or managed: references.
WP_MUSIC_USER=
WP_MUSIC_PASSWORD=

# Example Ghost Custom Integration Admin API key.
# Format is id:hex_secret. Blog configuration stores only a secret reference.
GHOST_MUSIC_ADMIN_KEY=

# Google OAuth refresh credentials shared by Search Console / GA4.
# Refreshed access tokens are cached in memory only and are never written to the store.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional reference overrides for managed secret backends.
GOOGLE_REFRESH_TOKEN_REF=
GOOGLE_CLIENT_ID_REF=
GOOGLE_CLIENT_SECRET_REF=

# Optional compatibility fallback: already-issued access tokens.
# If refresh credentials above are unavailable, each source can use its own access-token reference.
GSC_ACCESS_TOKEN=
GA4_ACCESS_TOKEN=

# Optional custom metrics endpoint bearer token.
BLOG_METRICS_TOKEN=
